{
    "name": "lanzer-lox",
    "description": "Example Lanzer host integration for the (unmodified) langium-lox language",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "bin": {
        "lox-lanzer": "./bin/lox-lanzer.js"
    },
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr out *.tsbuildinfo",
        "build": "tsc -b tsconfig.json",
        "build:clean": "npm run clean && npm run build",
        "test": "tsc -p test/tsconfig.json && vitest run"
    },
    "dependencies": {
        "commander": "~11.1.0",
        "langium": "~4.4.0",
        "langium-lox": "0.0.2",
        "lanzer": "0.0.1"
    },
    "devDependencies": {
        "@types/node": "~20.17.48",
        "vitest": "~4.1.9"
    },
    "volta": {
        "node": "20.19.2",
        "npm": "10.8.2"
    }
}
