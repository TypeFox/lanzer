# Codex settings for `lox-lanzer generate`: copy to `.env`. Details: README, "Agent configuration".
# Run with: node --env-file=.env ./bin/lox-lanzer.js generate <campaign.lanzer>

# Codex through its ACP adapter (sign in first: npx -y @openai/codex login).
LANZER_ACP_COMMAND=npx
LANZER_ACP_ARGS=["-y","@agentclientprotocol/codex-acp"]
LANZER_ACP_PROVIDER=codex

# Codex model id.
LANZER_ACP_MODEL=gpt-5.5
# LANZER_ACP_MODEL=gpt-6.1-sol

# Reasoning effort: low, medium, high or xhigh.
LANZER_ACP_EFFORT=medium

# Prompts per session before giving up (default 2).
LANZER_ACP_MAX_ATTEMPTS=2

# ACP tool kinds the agent may use; unset means read,edit,search,think,other.
# LANZER_ACP_ALLOW=read,edit,search,think,other,execute
