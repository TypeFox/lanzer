print gcd(17, 5);

var primes = "";
for (var n = 0; n <= 30; n = n + 1) {
    if (isPrime(n)) {
        if (primes == "") {
            primes = "" + n;
        } else {
            primes = primes + " " + n;
        }
    }
}
print primes;
print isPrime(1);
print isPrime(91);
