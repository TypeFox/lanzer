# Agent settings for `lox-lanzer generate`: copy to `.env`. Details: README, "Agent configuration".
# lox-lanzer reads ./.env by itself: npx lox-lanzer generate <campaign.lanzer>

# The ACP agent to launch (Claude, Codex, Gemini).
LANZER_ACP_COMMAND=npx
LANZER_ACP_ARGS=["claude-agent-acp"]
# LANZER_ACP_ARGS=["-y","@agentclientprotocol/codex-acp"]
# LANZER_ACP_ARGS=["-y","@google/gemini-cli","--acp"]

# codex (or openai) for Codex; leave unset for any other agent.
# LANZER_ACP_PROVIDER=codex

# The agent's own model alias, not an API model id.
# LANZER_ACP_MODEL=sonnet
# LANZER_ACP_MODEL=opus
# LANZER_ACP_MODEL=haiku
# LANZER_ACP_MODEL=gpt-5.5

# Reasoning effort.
# LANZER_ACP_EFFORT=low
# LANZER_ACP_EFFORT=medium
# LANZER_ACP_EFFORT=high
# LANZER_ACP_EFFORT=max

# Prompts per session before giving up (default 2).
LANZER_ACP_MAX_ATTEMPTS=2

# ACP tool kinds the agent may use; unset means read,edit,search,think,other.
# LANZER_ACP_ALLOW=read,edit,search,think,other,execute
# LANZER_ACP_ALLOW=read,search,think
# LANZER_ACP_ALLOW=all

# 1 to run without your own agent setup (CLAUDE.md, settings, skills, memory), for benchmarks.
# LANZER_ACP_ISOLATED=1
