# Lanzer ACP (Agent Client Protocol) configuration for the `lox-lanzer generate` command.
# Copy to `.env` and edit, then run with: node --env-file=.env ./bin/lox-lanzer.js generate ...
# Only `generate` needs this — `validate` and `plan` never call an agent.

# Command that launches your ACP-compatible coding agent (default: claude-agent-acp)
LANZER_ACP_COMMAND=claude-agent-acp

# Extra args passed to the command, as a JSON array string.
# Example, running Codex over npx instead of the default:
#   LANZER_ACP_COMMAND=npx
#   LANZER_ACP_ARGS=["-y","@zed-industries/codex-acp"]
# LANZER_ACP_ARGS=

# Optional agent routing
# LANZER_ACP_PROVIDER=
# LANZER_ACP_MODEL=
# LANZER_ACP_EFFORT=

# Max prompts per generation session before giving up (integer, default 2)
LANZER_ACP_MAX_ATTEMPTS=2
