# Lanzer ACP (Agent Client Protocol) configuration for the `lox-lanzer generate` command.
# Copy to `.env` and edit, then run with: node --env-file=.env ./bin/lox-lanzer.js generate ...
# Only `generate` needs this — `validate` and `plan` never call an agent.

# Command that launches your ACP-compatible coding agent.
# Use `npx` so the agent bin resolves from node_modules regardless of cwd (and after `npm install`).
LANZER_ACP_COMMAND=npx
LANZER_ACP_ARGS=["claude-agent-acp"]

# Other agents, e.g. Codex:
#   LANZER_ACP_COMMAND=npx
#   LANZER_ACP_ARGS=["-y","@zed-industries/codex-acp"]

# Which agent transport to use.
#
# Only `codex` and `openai` mean anything to Lanzer, and only to pick a transport — every other
# value, `claude` included, is ignored. Leaving it unset is right for any ACP agent.
#
#   unset / anything else   the normal ACP path (what claude-agent-acp uses)
#   codex | openai          the Codex MCP transport — UNLESS the command below is codex-acp
#
# That exception is the part worth reading. Codex has two front ends, and they are not equivalent:
#
#   ARGS=["-y","@zed-industries/codex-acp"]   speaks ACP -> full ACP path, LANZER_ACP_ALLOW enforced
#   ARGS=["-y","@openai/codex"]               speaks MCP -> MCP transport, no permission callback
#                                             exists, so `execute` cannot be withheld (the run warns)
#
# Prefer codex-acp. Set this to `codex` either way; with codex-acp it stays on the ACP path.
# An empty value (`LANZER_ACP_PROVIDER=`) is treated the same as unset.
# LANZER_ACP_PROVIDER=

# Model. These are the agent's own aliases, NOT API model ids — `claude-sonnet-4-6` is rejected
# during session setup and fails the run before any prompt is sent. claude-agent-acp currently
# offers: default, opus[1m], claude-fable-5-1[1m], sonnet, haiku. The list varies by agent and by
# what your account can reach, so check yours; an unknown value is reported and skipped, and the
# run continues on the agent's default.
# LANZER_ACP_MODEL=sonnet

# Reasoning effort. claude-agent-acp offers: default, low, medium, high, xhigh, max.
# LANZER_ACP_EFFORT=medium

# Max prompts per generation session before giving up (integer, default 2)
LANZER_ACP_MAX_ATTEMPTS=2

# What the agent is allowed to do, as a comma-separated list of ACP tool kinds:
#   read  edit  delete  move  search  execute  think  fetch  switch_mode  other
#
# Leave this unset for the generation baseline — read, edit, search, think, other — which is
# what writing files needs and nothing more. Setting it replaces that baseline outright: the
# run is limited to exactly the kinds you name, so this one setting both widens and narrows.
#
# `execute` is the one worth thinking about. Lanzer confines the agent's reads and writes to the
# campaign's own directories, but an agent that can run shell commands goes around that check,
# so shell access is off unless you ask for it here. Add it only if a campaign genuinely needs
# to run something — validation is Lanzer's job, not the agent's.
#
#   LANZER_ACP_ALLOW=read,edit,search,think,other,execute
#   LANZER_ACP_ALLOW=all      # everything, including the shell and network access
# LANZER_ACP_ALLOW=

