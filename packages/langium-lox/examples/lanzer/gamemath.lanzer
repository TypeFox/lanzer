// A multi-file Lanzer campaign targeting the langium-lox grammar.
//
// Generates a small "game math" library: 2D vectors, 3D vectors, matrices,
// and a demo entry point. langium-lox is statically typed and has NO classes,
// NO arrays/structs, and NO built-ins (no sqrt). So vectors and matrices are
// modeled as their scalar *components* passed as `number` parameters, and every
// helper returns a scalar `number`:
//   - "length" -> lengthSquared (avoids the missing sqrt)
//   - cross product -> one function per output component
//   - matrix ops -> determinants and component-wise matrix*vector
// Selectors are written against the real Lox AST (LoxProgram is the entry rule;
// FunctionDeclaration / Parameter / TypeReference / BinaryExpression /
// ReturnStatement / MemberCall / PrintStatement / Class are real node types).

import "../../langium/src/language-server/lox.langium"

campaign loxGameMath {
    description "A typed-Lox game math library: 2D/3D vector helpers and matrix helpers (scalar components, no classes), plus a demo entry point."
    workspace "out"

    file vec2 at "vec2.lox" generates LoxProgram {
        description "2D vector helpers operating on (x, y) number components: dot product, squared length, squared distance, and the 2D cross product (a scalar). Every parameter and return type is number."

        require FunctionDeclaration[name="vec2Dot"]
        require FunctionDeclaration[name="vec2LengthSquared"]
        require FunctionDeclaration[name="vec2DistanceSquared"]
        // 2D cross product is the scalar ax*by - ay*bx.
        require FunctionDeclaration[name="vec2Cross"]

        // Helpers are numeric: parameters/returns are the `number` primitive.
        require FunctionDeclaration[name="vec2Dot"] >> TypeReference[primitive="number"]
        // The dot product must actually multiply, and each helper must return.
        require FunctionDeclaration[name="vec2Dot"] >> BinaryExpression[operator="*"]
        require FunctionDeclaration[name="vec2Dot"] >> ReturnStatement

        min 4 FunctionDeclaration
        // No structs/classes and no modulo in langium-lox.
        forbid Class
        forbid BinaryExpression[operator="%"]
    }

    file vec3 at "vec3.lox" generates LoxProgram {
        description "3D vector helpers operating on (x, y, z) number components: dot product, squared length, squared distance, and the cross product split into vec3CrossX/Y/Z (one function per output component, since a vector cannot be returned as a single value)."

        require FunctionDeclaration[name="vec3Dot"]
        require FunctionDeclaration[name="vec3LengthSquared"]
        require FunctionDeclaration[name="vec3DistanceSquared"]
        // Component-wise cross product: x, y and z outputs are separate helpers.
        require FunctionDeclaration[name="vec3CrossX"]
        require FunctionDeclaration[name="vec3CrossY"]
        require FunctionDeclaration[name="vec3CrossZ"]

        // Numeric typing and real arithmetic.
        require FunctionDeclaration[name="vec3LengthSquared"] >> TypeReference[primitive="number"]
        require FunctionDeclaration[name="vec3Dot"] >> BinaryExpression[operator="*"]
        // The cross product subtracts: e.g. CrossX = ay*bz - az*by.
        require FunctionDeclaration[name="vec3CrossX"] >> BinaryExpression[operator="-"]

        min 6 FunctionDeclaration
        forbid Class
        forbid BinaryExpression[operator="%"]
    }

    file matrix at "matrix.lox" generates LoxProgram {
        description "Matrix helpers on flat number components: mat2Determinant(a,b,c,d), mat3Determinant of nine components, and component-wise 2x2 matrix * 2D vector (mat2MulVecX / mat2MulVecY). All scalar in, scalar out."

        require FunctionDeclaration[name="mat2Determinant"]
        require FunctionDeclaration[name="mat3Determinant"]
        // Matrix * vector, one helper per output component.
        require FunctionDeclaration[name="mat2MulVecX"]
        require FunctionDeclaration[name="mat2MulVecY"]

        // 2x2 determinant is a*d - b*c: it must multiply and subtract.
        require FunctionDeclaration[name="mat2Determinant"] >> BinaryExpression[operator="*"]
        require FunctionDeclaration[name="mat2Determinant"] >> BinaryExpression[operator="-"]
        require FunctionDeclaration[name="mat2Determinant"] >> ReturnStatement

        min 4 FunctionDeclaration
        forbid Class
        forbid BinaryExpression[operator="%"]
    }

    file main at "main.lox" generates LoxProgram {
        description "Demo entry point. Defines a couple of self-contained game helpers (e.g. clamp(value, lo, hi) and lerp(a, b, t)) and a main() that calls them with sample values and prints the results. Stays self-contained so it validates on its own."

        require FunctionDeclaration[name="main"]
        // main must call at least one helper...
        require FunctionDeclaration[name="main"] >> MemberCall[explicitOperationCall]
        // ...and print results.
        require PrintStatement
        min 2 PrintStatement

        min 2 FunctionDeclaration
        forbid Class
        forbid BinaryExpression[operator="%"]
    }

    // Campaign-level constraints spanning the whole generated set.
    forbid Class
    require FunctionDeclaration[name="vec2Cross"] in vec2
    require FunctionDeclaration[name="vec3CrossX"] in vec3
    require FunctionDeclaration[name="mat3Determinant"] in matrix
    require FunctionDeclaration[name="main"] in main
}
