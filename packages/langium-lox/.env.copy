# ACP runtime configuration for `lox-lanzer generate`.
#
# Copy this file to `.env` (which is gitignored) and uncomment / edit the block for the
# agent runtime you want to drive generation. Load it when invoking the CLI, e.g.:
#
#   node --env-file=.env ./bin/lox-lanzer.js generate ./examples/lanzer/calculator.lanzer
#
# Every variable is optional; the CLI falls back to `claude-agent-acp` as the command.

# --- Claude (Agent Client Protocol bridge shipped with the lanzer dependency) ---
# Path is relative to this package dir; deps hoist to the monorepo root, hence ../../.
# LANZER_ACP_COMMAND=../../node_modules/.bin/claude-agent-acp
# LANZER_ACP_PROVIDER=claude
# LANZER_ACP_MODEL=claude-sonnet-4-6
# LANZER_ACP_EFFORT=medium
# LANZER_ACP_MAX_ATTEMPTS=2

# --- Codex ---
# LANZER_ACP_COMMAND=npx
# LANZER_ACP_ARGS='["-y","@zed-industries/codex-acp"]'
# LANZER_ACP_PROVIDER=codex
# LANZER_ACP_MODEL=gpt-5.3-codex
# LANZER_ACP_EFFORT=medium
# LANZER_ACP_MAX_ATTEMPTS=2

# --- Custom agent wrapper ---
# LANZER_ACP_COMMAND=node
# LANZER_ACP_ARGS='["/absolute/path/to/custom-agent-wrapper.mjs"]'

# LANZER_ACP_ARGS must be a JSON array string when set.
