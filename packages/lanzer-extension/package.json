{
    "name": "lanzer-extension",
    "description": "VS Code extension providing language support for Lanzer (.lanzer) campaign files",
    "version": "0.0.1",
    "displayName": "Lanzer",
    "type": "module",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "lanzer",
                "aliases": ["Lanzer", "lanzer"],
                "extensions": [".lanzer"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "lanzer",
                "scopeName": "source.lanzer",
                "path": "syntaxes/lanzer.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:lanzer"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../lanzer/syntaxes/lanzer.tmLanguage.json ./syntaxes/lanzer.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
        "vscode:prepublish": "npm run build"
    },
    "dependencies": {
        "lanzer": "0.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.85.0",
        "concurrently": "~8.2.1",
        "esbuild": "~0.25.5"
    },
    "vsce": {
        "dependencies": false
    }
}
