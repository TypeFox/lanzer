// A minimal Lanzer campaign targeting the Lox grammar.
//
// It asks the generator to produce a single .lox file that defines a `greet`
// function and a `main`, prints something, and keeps to plain functions — the
// `forbid Class` below is this campaign's choice; langium-lox supports classes (see
// packages/lanzer-lox/examples/classes.lanzer). Selectors are written against the
// Lox AST (LoxProgram is the entry rule; FunctionDeclaration/PrintStatement/Class
// are real Lox node types).

import "../../../packages/langium-lox/langium/src/language-server/lox.langium"

campaign loxHello {
    description "A tiny typed-Lox program with a greet function and a main entry point."
    workspace "out"

    file main at "hello.lox" generates LoxProgram {
        description "Defines greet(name: string): void and main(): void; main calls greet and prints."

        // Must define a `greet` function...
        require FunctionDeclaration[name="greet"]
        // ...and a `main` function that calls something (e.g. greet).
        require FunctionDeclaration[name="main"]
        require FunctionDeclaration[name="main"] >> MemberCall[explicitOperationCall]
        // The program prints at least once.
        require PrintStatement
        // At least two functions overall.
        min 2 FunctionDeclaration
        // Keep this program to plain functions (a campaign choice; Lox has classes).
        forbid Class
    }
}
